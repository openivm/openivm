# name: test/sql/issue_225_semi_anti_left_subquery.test
# description: IN / NOT IN / EXISTS / NOT EXISTS views whose left side is a subquery or a join (#225, #40)
# group: [sql]

# The left side of the semi/anti join is a derived table, or a join of several tables. Refresh must read
# the deltas of every table under it (#225), and outputs and filters qualified with the joined tables must
# bind (#40). These views keep the incremental semi/anti aux-state path (type 9).

require openivm

statement ok
SET openivm_disable_daemon = true;

statement ok
CREATE TABLE l225_a (id INTEGER, x INTEGER);

statement ok
CREATE TABLE l225_b (id INTEGER, w INTEGER);

statement ok
CREATE TABLE l225_c (id INTEGER, z INTEGER);

statement ok
INSERT INTO l225_a VALUES (1, 10), (1, 10), (2, 20), (4, 40), (NULL, 50), (7, -70);

statement ok
INSERT INTO l225_b VALUES (1, 1), (2, 2), (5, 5), (7, 100);

statement ok
INSERT INTO l225_c VALUES (1, 100), (1, 101), (2, 200), (3, 300), (4, 400), (7, 700);

# The #225 repro: a derived table over one table.
statement ok
CREATE MATERIALIZED VIEW l225_in_sub AS
    SELECT id, x FROM (SELECT id, x FROM l225_a) s WHERE id IN (SELECT l225_b.id FROM l225_b);

statement ok
CREATE VIEW expected_l225_in_sub AS
    SELECT id, x FROM (SELECT id, x FROM l225_a) s WHERE id IN (SELECT l225_b.id FROM l225_b);

statement ok
CREATE MATERIALIZED VIEW l225_notin_sub AS
    SELECT id, x FROM (SELECT id, x FROM l225_a WHERE x > 0) s WHERE id NOT IN (SELECT id FROM l225_b);

statement ok
CREATE VIEW expected_l225_notin_sub AS
    SELECT id, x FROM (SELECT id, x FROM l225_a WHERE x > 0) s WHERE id NOT IN (SELECT id FROM l225_b);

statement ok
CREATE MATERIALIZED VIEW l225_exists_sub AS
    SELECT id, x FROM (SELECT id, x FROM l225_a) s WHERE EXISTS (SELECT 1 FROM l225_b b WHERE b.id = s.id);

statement ok
CREATE VIEW expected_l225_exists_sub AS
    SELECT id, x FROM (SELECT id, x FROM l225_a) s WHERE EXISTS (SELECT 1 FROM l225_b b WHERE b.id = s.id);

statement ok
CREATE MATERIALIZED VIEW l225_notexists_sub AS
    SELECT id, x FROM (SELECT id, x FROM l225_a) s
    WHERE NOT EXISTS (SELECT 1 FROM l225_b b WHERE b.id = s.id AND b.w < s.x);

statement ok
CREATE VIEW expected_l225_notexists_sub AS
    SELECT id, x FROM (SELECT id, x FROM l225_a) s
    WHERE NOT EXISTS (SELECT 1 FROM l225_b b WHERE b.id = s.id AND b.w < s.x);

# A derived table over a join (the second #225 shape).
statement ok
CREATE MATERIALIZED VIEW l225_in_subjoin AS
    SELECT id, z FROM (SELECT a.id, c.z FROM l225_a a JOIN l225_c c ON a.id = c.id) s
    WHERE id IN (SELECT l225_b.id FROM l225_b);

statement ok
CREATE VIEW expected_l225_in_subjoin AS
    SELECT id, z FROM (SELECT a.id, c.z FROM l225_a a JOIN l225_c c ON a.id = c.id) s
    WHERE id IN (SELECT l225_b.id FROM l225_b);

statement ok
CREATE MATERIALIZED VIEW l225_notin_subjoin AS
    SELECT id, z FROM (SELECT a.id, c.z FROM l225_a a JOIN l225_c c ON a.id = c.id) s
    WHERE z > 100 AND id NOT IN (SELECT b.id FROM l225_b b WHERE b.w < s.z);

statement ok
CREATE VIEW expected_l225_notin_subjoin AS
    SELECT id, z FROM (SELECT a.id, c.z FROM l225_a a JOIN l225_c c ON a.id = c.id) s
    WHERE z > 100 AND id NOT IN (SELECT b.id FROM l225_b b WHERE b.w < s.z);

statement ok
CREATE MATERIALIZED VIEW l225_exists_subjoin AS
    SELECT id, z FROM (SELECT a.id, c.z FROM l225_a a JOIN l225_c c ON a.id = c.id) s
    WHERE EXISTS (SELECT 1 FROM l225_b b WHERE b.id = s.id);

statement ok
CREATE VIEW expected_l225_exists_subjoin AS
    SELECT id, z FROM (SELECT a.id, c.z FROM l225_a a JOIN l225_c c ON a.id = c.id) s
    WHERE EXISTS (SELECT 1 FROM l225_b b WHERE b.id = s.id);

statement ok
CREATE MATERIALIZED VIEW l225_notexists_subjoin AS
    SELECT id, z FROM (SELECT a.id, c.z FROM l225_a a JOIN l225_c c ON a.id = c.id) s
    WHERE NOT EXISTS (SELECT 1 FROM l225_b b WHERE b.id = s.id);

statement ok
CREATE VIEW expected_l225_notexists_subjoin AS
    SELECT id, z FROM (SELECT a.id, c.z FROM l225_a a JOIN l225_c c ON a.id = c.id) s
    WHERE NOT EXISTS (SELECT 1 FROM l225_b b WHERE b.id = s.id);

# The #40 shape: the left side is a join and outputs and filters are qualified with its tables.
statement ok
CREATE MATERIALIZED VIEW l225_in_join AS
    SELECT l225_a.id, l225_c.z FROM l225_a JOIN l225_c ON l225_a.id = l225_c.id
    WHERE l225_a.id IN (SELECT id FROM l225_b);

statement ok
CREATE VIEW expected_l225_in_join AS
    SELECT l225_a.id, l225_c.z FROM l225_a JOIN l225_c ON l225_a.id = l225_c.id
    WHERE l225_a.id IN (SELECT id FROM l225_b);

statement ok
CREATE MATERIALIZED VIEW l225_notin_join AS
    SELECT a.id, a.x, c.z FROM l225_a a JOIN l225_c c ON a.id = c.id
    WHERE a.x > 0 AND a.id NOT IN (SELECT id FROM l225_b WHERE id IS NOT NULL);

statement ok
CREATE VIEW expected_l225_notin_join AS
    SELECT a.id, a.x, c.z FROM l225_a a JOIN l225_c c ON a.id = c.id
    WHERE a.x > 0 AND a.id NOT IN (SELECT id FROM l225_b WHERE id IS NOT NULL);

statement ok
CREATE MATERIALIZED VIEW l225_exists_join AS
    SELECT a.id, c.z FROM l225_a a JOIN l225_c c ON a.id = c.id
    WHERE EXISTS (SELECT 1 FROM l225_b b WHERE b.id = a.id AND b.w * 10 <= c.z);

statement ok
CREATE VIEW expected_l225_exists_join AS
    SELECT a.id, c.z FROM l225_a a JOIN l225_c c ON a.id = c.id
    WHERE EXISTS (SELECT 1 FROM l225_b b WHERE b.id = a.id AND b.w * 10 <= c.z);

statement ok
CREATE MATERIALIZED VIEW l225_notexists_join AS
    SELECT a.id, c.z FROM l225_a a JOIN l225_c c ON a.id = c.id
    WHERE NOT EXISTS (SELECT 1 FROM l225_b b WHERE b.id = a.id);

statement ok
CREATE VIEW expected_l225_notexists_join AS
    SELECT a.id, c.z FROM l225_a a JOIN l225_c c ON a.id = c.id
    WHERE NOT EXISTS (SELECT 1 FROM l225_b b WHERE b.id = a.id);

# A self-join under a nested derived table, and SELECT * over a derived table.
statement ok
CREATE MATERIALIZED VIEW l225_in_selfjoin AS
    SELECT id, s FROM (SELECT id, s FROM (SELECT p.id, p.x + q.x AS s FROM l225_a p, l225_a q WHERE p.id = q.id) i
    WHERE s > 0) t WHERE id IN (SELECT id FROM l225_b);

statement ok
CREATE VIEW expected_l225_in_selfjoin AS
    SELECT id, s FROM (SELECT id, s FROM (SELECT p.id, p.x + q.x AS s FROM l225_a p, l225_a q WHERE p.id = q.id) i
    WHERE s > 0) t WHERE id IN (SELECT id FROM l225_b);

statement ok
CREATE MATERIALIZED VIEW l225_notin_star AS
    SELECT * FROM (SELECT id, x FROM l225_a WHERE x > 10) s WHERE id NOT IN (SELECT id FROM l225_b);

statement ok
CREATE VIEW expected_l225_notin_star AS
    SELECT * FROM (SELECT id, x FROM l225_a WHERE x > 10) s WHERE id NOT IN (SELECT id FROM l225_b);

# All use the incremental semi/anti aux state, not FULL_REFRESH.
query II
SELECT view_sql_name, type FROM openivm_views ORDER BY 1;
----
l225_exists_join	9
l225_exists_sub	9
l225_exists_subjoin	9
l225_in_join	9
l225_in_selfjoin	9
l225_in_sub	9
l225_in_subjoin	9
l225_notexists_join	9
l225_notexists_sub	9
l225_notexists_subjoin	9
l225_notin_join	9
l225_notin_star	9
l225_notin_sub	9
l225_notin_subjoin	9

foreach mv l225_in_sub l225_notin_sub l225_exists_sub l225_notexists_sub l225_in_subjoin l225_notin_subjoin l225_exists_subjoin l225_notexists_subjoin l225_in_join l225_notin_join l225_exists_join l225_notexists_join l225_in_selfjoin l225_notin_star

query I
SELECT count(*) FROM ((SELECT * FROM {mv} EXCEPT ALL SELECT * FROM expected_{mv})
    UNION ALL (SELECT * FROM expected_{mv} EXCEPT ALL SELECT * FROM {mv}));
----
0

endloop

loop round 0 3

# One conflicting batch on every table before each refresh: rows are inserted, updated and
# deleted on both sides of the left join and on the subquery table, including NULL keys.
statement ok
INSERT INTO l225_a VALUES (3, 30 + {round}), (6, 60), (1, 10), (NULL, 51);

statement ok
UPDATE l225_a SET x = x + 1 WHERE id = 2 OR id = 6;

statement ok
DELETE FROM l225_a WHERE id = 4 OR (id = 3 AND {round} = 1) OR (id IS NULL AND x = 51);

statement ok
UPDATE l225_a SET id = 5 WHERE id = 1 AND {round} = 2;

statement ok
INSERT INTO l225_b VALUES (3, 3), (4, 4), (NULL, {round});

statement ok
DELETE FROM l225_b WHERE id = 5 OR (id IS NULL AND {round} <> 1) OR (id = 1 AND {round} = 1);

statement ok
UPDATE l225_b SET w = w * 10 WHERE id = 2;

statement ok
INSERT INTO l225_b VALUES (1, {round});

statement ok
INSERT INTO l225_c VALUES (6, 600), (3, 301), (5, 500 + {round});

statement ok
UPDATE l225_c SET z = z + 1 WHERE id IN (1, 3);

statement ok
DELETE FROM l225_c WHERE id = 4 OR (id = 2 AND {round} = 1);

statement ok
INSERT INTO l225_a VALUES (4, 41);

statement ok
INSERT INTO l225_c VALUES (2, 200), (4, 400 + {round});

foreach mv l225_in_sub l225_notin_sub l225_exists_sub l225_notexists_sub l225_in_subjoin l225_notin_subjoin l225_exists_subjoin l225_notexists_subjoin l225_in_join l225_notin_join l225_exists_join l225_notexists_join l225_in_selfjoin l225_notin_star

statement ok
PRAGMA refresh('{mv}');

query I
SELECT count(*) FROM ((SELECT * FROM {mv} EXCEPT ALL SELECT * FROM expected_{mv})
    UNION ALL (SELECT * FROM expected_{mv} EXCEPT ALL SELECT * FROM {mv}));
----
0

endloop

endloop

# The #225 repro returns the current rows.
statement ok
CREATE TABLE r225_a (id INT, x INT);

statement ok
CREATE TABLE r225_b (id INT);

statement ok
INSERT INTO r225_a VALUES (1, 10), (2, 20);

statement ok
INSERT INTO r225_b VALUES (1), (2);

statement ok
CREATE MATERIALIZED VIEW r225_vs AS SELECT id, x FROM (SELECT id, x FROM r225_a) s WHERE id IN (SELECT r225_b.id FROM r225_b);

statement ok
INSERT INTO r225_a VALUES (3, 30);

statement ok
INSERT INTO r225_b VALUES (3);

statement ok
UPDATE r225_a SET x = x + 1 WHERE id = 1;

statement ok
DELETE FROM r225_a WHERE id = 2;

statement ok
PRAGMA refresh('r225_vs');

query II
SELECT * FROM r225_vs ORDER BY id;
----
1	11
3	30

query I
SELECT count(*) FROM ((SELECT * FROM r225_vs EXCEPT ALL SELECT id, x FROM (SELECT id, x FROM r225_a) s WHERE id IN (SELECT r225_b.id FROM r225_b))
    UNION ALL (SELECT id, x FROM (SELECT id, x FROM r225_a) s WHERE id IN (SELECT r225_b.id FROM r225_b) EXCEPT ALL SELECT * FROM r225_vs));
----
0
