endloop

statement ok
SET openivm_refresh_mode = 'incremental';

statement ok
DELETE FROM l225_b WHERE id = 30 + {round} OR (id = 6 AND w = 0);

statement ok
INSERT INTO l225_a VALUES (2, 22);

statement ok
UPDATE l225_a SET x = x + 1 WHERE id = 31 + {round};

foreach mv l225_full_sub l225_full_plain

statement ok
PRAGMA refresh('{mv}');

query I
SELECT count(*) FROM ((SELECT * FROM {mv} EXCEPT ALL SELECT * FROM expected_{mv})
    UNION ALL (SELECT * FROM expected_{mv} EXCEPT ALL SELECT * FROM {mv}));
----
0

endloop

endloop

# Metadata written before derived_left stored the left subquery as an opaque wrapper whose deltas
# refresh never read. Such a view asks to be recreated instead of refreshing wrongly.
statement ok
UPDATE openivm_views SET semi_anti_aux_meta_json = replace(semi_anti_aux_meta_json, '"derived_left":"true",', '')
WHERE view_sql_name = 'l225_full_sub';

statement ok
INSERT INTO l225_a VALUES (40, 400);

statement error
PRAGMA refresh('l225_full_sub');
----
recreate the materialized view
