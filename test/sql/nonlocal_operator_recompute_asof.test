statement ok
PRAGMA refresh('asof_cast_mv');

query I
SELECT count(*) FROM (
    (FROM asof_cast_mv EXCEPT ALL FROM asof_cast_expected)
    UNION ALL
    (FROM asof_cast_expected EXCEPT ALL FROM asof_cast_mv)
);
----
0

query I
SELECT count(*) FILTER (WHERE contains(sql, 'openivm_window_current')) > 0
FROM openivm_compiled_statements
WHERE operation = 'refresh'
  AND view_name = (SELECT view_name FROM openivm_views WHERE view_sql_name = 'asof_cast_mv');
----
true
