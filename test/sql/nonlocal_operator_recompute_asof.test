# A widened left key still identifies the affected ASOF window partitions.
statement ok
SET openivm_archive_compiled_sql = true;
CREATE TABLE asof_widened_trades (id INT, k INT, ts INT);
CREATE TABLE asof_widened_prices (k INT, ts INT, price INT);
INSERT INTO asof_widened_trades VALUES (1,1,10),(2,1,20),(3,2,30);
INSERT INTO asof_widened_prices VALUES (1,1,120),(1,15,150),(2,20,200);
CREATE VIEW asof_widened_expected AS
    SELECT t.id,t.k,t.ts,p.price,row_number() OVER (PARTITION BY t.k ORDER BY t.id) AS rn
    FROM (SELECT id,k::BIGINT AS k,ts FROM asof_widened_trades) t
    ASOF JOIN asof_widened_prices p ON t.k=p.k AND t.ts>=p.ts;
CREATE MATERIALIZED VIEW asof_widened_mv AS
    SELECT t.id,t.k,t.ts,p.price,row_number() OVER (PARTITION BY t.k ORDER BY t.id) AS rn
    FROM (SELECT id,k::BIGINT AS k,ts FROM asof_widened_trades) t
    ASOF JOIN asof_widened_prices p ON t.k=p.k AND t.ts>=p.ts;

query I
SELECT type FROM openivm_views WHERE view_sql_name = 'asof_widened_mv';
----
5

statement ok
INSERT INTO asof_widened_trades VALUES (4,1,13),(5,2,35);
UPDATE asof_widened_prices SET price=160 WHERE k=1 AND ts=15;
DELETE FROM asof_widened_trades WHERE id IN (1,5);

statement ok
PRAGMA refresh('asof_widened_mv');

query I
SELECT count(*) FROM (
    (FROM asof_widened_mv EXCEPT ALL FROM asof_widened_expected)
    UNION ALL
    (FROM asof_widened_expected EXCEPT ALL FROM asof_widened_mv)
);
----
0

query I
SELECT count(*) FILTER (WHERE contains(sql, 'openivm_changed_partitions')) > 0
       AND count(*) FILTER (WHERE contains(sql, 'openivm_window_current')) = 0
FROM openivm_compiled_statements
WHERE operation = 'refresh'
  AND view_name = (SELECT view_name FROM openivm_views WHERE view_sql_name = 'asof_widened_mv');
----
true

# A key whose lineage covers every source but is not a proven direct key (a VARCHAR
# cast is not invertible) keeps the ASOF window incremental through a result diff.
statement ok
CREATE TABLE asof_cast_trades (id INT, k INT, ts INT);
CREATE TABLE asof_cast_prices (k INT, ts INT, price INT);
INSERT INTO asof_cast_trades VALUES (1,1,10),(2,1,20),(3,2,30);
INSERT INTO asof_cast_prices VALUES (1,1,120),(1,15,150),(2,20,200);
CREATE VIEW asof_cast_expected AS
    SELECT t.id,t.k,t.ts,p.price,row_number() OVER (PARTITION BY t.k ORDER BY t.id) AS rn
    FROM (SELECT id,k::VARCHAR AS k,ts FROM asof_cast_trades) t
    ASOF JOIN (SELECT k::VARCHAR AS k,ts,price FROM asof_cast_prices) p ON t.k=p.k AND t.ts>=p.ts;
CREATE MATERIALIZED VIEW asof_cast_mv AS
    SELECT t.id,t.k,t.ts,p.price,row_number() OVER (PARTITION BY t.k ORDER BY t.id) AS rn
    FROM (SELECT id,k::VARCHAR AS k,ts FROM asof_cast_trades) t
    ASOF JOIN (SELECT k::VARCHAR AS k,ts,price FROM asof_cast_prices) p ON t.k=p.k AND t.ts>=p.ts;

query II
SELECT type, lineage_json LIKE '%"proven_columns":[]%' FROM openivm_views WHERE view_sql_name = 'asof_cast_mv';
----
5	true

statement ok
INSERT INTO asof_cast_trades VALUES (4,1,13),(5,2,35),(6,3,40);
