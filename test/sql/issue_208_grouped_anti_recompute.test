statement ok
UPDATE jb SET j = 400 WHERE k = 2;

statement ok
DELETE FROM ja WHERE k1 = 3;

statement ok
INSERT INTO ja VALUES (6, 60, 400), (1, 70, 200);

# refresh after deleting joined rows from both tables in one batch
foreach view jne jex jni jlj jout

statement ok
PRAGMA refresh('mv_{view}');

query I
SELECT COUNT(*) FROM (SELECT * FROM mv_{view} EXCEPT ALL SELECT * FROM q_{view});
----
0

query I
SELECT COUNT(*) FROM (SELECT * FROM q_{view} EXCEPT ALL SELECT * FROM mv_{view});
----
0

endloop

statement ok
DELETE FROM ja WHERE k2 = 200;

statement ok
DELETE FROM jc WHERE k = 200;

statement ok
DELETE FROM jb WHERE k = 4;

statement ok
INSERT INTO jc VALUES (200, 22);

statement ok
DELETE FROM jc WHERE k = 900;

statement ok
UPDATE ja SET k1 = 4 WHERE k1 = 6;

# refresh after a second mixed batch on all three tables
foreach view jne jex jni jlj jout

statement ok
PRAGMA refresh('mv_{view}');

query I
SELECT COUNT(*) FROM (SELECT * FROM mv_{view} EXCEPT ALL SELECT * FROM q_{view});
----
0

query I
SELECT COUNT(*) FROM (SELECT * FROM q_{view} EXCEPT ALL SELECT * FROM mv_{view});
----
0

endloop

# An aggregate inside the NOT IN / IN subquery: a changed row changes the aggregate value,
# not just the rows it matches, so affected groups come from the current-view diff.
statement ok
CREATE TABLE ga(k1 INT, v INT);

statement ok
CREATE TABLE gb(k INT, g INT);

statement ok
INSERT INTO ga VALUES (3, 1), (5, 1), (7, 2), (4, 2);

statement ok
INSERT INTO gb VALUES (5, 1), (3, 1), (7, 2);

statement ok
CREATE MATERIALIZED VIEW mv_gni AS SELECT k1, COUNT(*) AS n FROM ga WHERE k1 NOT IN (SELECT MAX(k) FROM gb GROUP BY g) GROUP BY k1;

statement ok
CREATE VIEW q_gni AS SELECT k1, COUNT(*) AS n FROM ga WHERE k1 NOT IN (SELECT MAX(k) FROM gb GROUP BY g) GROUP BY k1;

statement ok
CREATE MATERIALIZED VIEW mv_gin AS SELECT k1, COUNT(*) AS n FROM ga WHERE k1 IN (SELECT MAX(k) FROM gb GROUP BY g) GROUP BY k1;

statement ok
CREATE VIEW q_gin AS SELECT k1, COUNT(*) AS n FROM ga WHERE k1 IN (SELECT MAX(k) FROM gb GROUP BY g) GROUP BY k1;

statement ok
CREATE MATERIALIZED VIEW mv_gniv AS SELECT v, COUNT(*) AS n FROM ga WHERE k1 NOT IN (SELECT COUNT(*) + 2 FROM gb GROUP BY g) GROUP BY v;

statement ok
CREATE VIEW q_gniv AS SELECT v, COUNT(*) AS n FROM ga WHERE k1 NOT IN (SELECT COUNT(*) + 2 FROM gb GROUP BY g) GROUP BY v;

# The aggregate-subquery shapes stay on group-recompute.
query II
SELECT view_sql_name, type FROM openivm_views WHERE view_sql_name IN ('mv_gin', 'mv_gni', 'mv_gniv') ORDER BY 1;
----
mv_gin	6
mv_gni	6
mv_gniv	6

statement ok
DELETE FROM gb WHERE k = 5;

statement ok
INSERT INTO gb VALUES (4, 3), (1, 3);

statement ok
UPDATE gb SET k = 8 WHERE k = 7;

statement ok
INSERT INTO ga VALUES (8, 3), (2, 3);

# refresh after changing the aggregated subquery table
foreach view gni gin gniv

statement ok
PRAGMA refresh('mv_{view}');

query I
SELECT COUNT(*) FROM (SELECT * FROM mv_{view} EXCEPT ALL SELECT * FROM q_{view});
----
0

query I
SELECT COUNT(*) FROM (SELECT * FROM q_{view} EXCEPT ALL SELECT * FROM mv_{view});
----
0

endloop

# NOT IN over a large left input: the affected-group discovery must stay a hash join on
# the subquery keys (a nested loop over the left input takes tens of seconds here).
statement ok
CREATE TABLE sa AS SELECT i AS k1, (i % 1000)::INT AS v FROM range(2000000) t(i);

statement ok
CREATE TABLE sb AS SELECT i * 7 AS k2, (i % 10)::INT AS g FROM range(200000) t(i);

statement ok
CREATE MATERIALIZED VIEW mv_sni AS SELECT v, COUNT(*) AS n FROM sa WHERE k1 NOT IN (SELECT k2 FROM sb) GROUP BY v;

statement ok
CREATE VIEW q_sni AS SELECT v, COUNT(*) AS n FROM sa WHERE k1 NOT IN (SELECT k2 FROM sb) GROUP BY v;

statement ok
CREATE MATERIALIZED VIEW mv_scor AS SELECT v % 10 AS w, COUNT(*) AS n FROM sa WHERE k1 NOT IN (SELECT k2 FROM sb WHERE sb.g = sa.v % 10) GROUP BY v % 10;

statement ok
CREATE VIEW q_scor AS SELECT v % 10 AS w, COUNT(*) AS n FROM sa WHERE k1 NOT IN (SELECT k2 FROM sb WHERE sb.g = sa.v % 10) GROUP BY v % 10;

# The large NOT IN views stay on group-recompute.
query II
SELECT view_sql_name, type FROM openivm_views WHERE view_sql_name IN ('mv_scor', 'mv_sni') ORDER BY 1;
----
mv_scor	6
mv_sni	6

statement ok
INSERT INTO sb SELECT i * 97 + 1, (i % 10)::INT FROM range(20000) t(i);

statement ok
DELETE FROM sb WHERE k2 % 49 = 0;

statement ok
UPDATE sb SET k2 = k2 + 3 WHERE k2 % 91 = 0;

statement ok
INSERT INTO sa VALUES (5000000, 3), (NULL, 4);

statement ok
DELETE FROM sa WHERE k1 % 100003 = 0;

statement ok
SET GLOBAL max_execution_time = 10000;

# refresh large NOT IN views within the time limit
foreach view sni scor

statement ok
PRAGMA refresh('mv_{view}');

query I
SELECT COUNT(*) FROM (SELECT * FROM mv_{view} EXCEPT ALL SELECT * FROM q_{view});
----
0

query I
SELECT COUNT(*) FROM (SELECT * FROM q_{view} EXCEPT ALL SELECT * FROM mv_{view});
----
0

endloop

statement ok
SET GLOBAL max_execution_time = 0;
