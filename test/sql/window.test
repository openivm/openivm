true

# Looking up a preserved row on the nullable side cannot discover the NULL
# partition when the join has no match.
statement ok
CREATE TABLE nullable_window_left (id INT, v INT);
CREATE TABLE nullable_window_right (id INT, "p=key" INT);
INSERT INTO nullable_window_left VALUES (1,10),(2,20);
INSERT INTO nullable_window_right VALUES (2,200);
CREATE VIEW nullable_window_expected AS
    SELECT a.id, a.v, b."p=key" AS pk,
           row_number() OVER (PARTITION BY b."p=key" ORDER BY a.id) AS rn
    FROM nullable_window_left a LEFT JOIN nullable_window_right b ON a.id=b.id;
CREATE MATERIALIZED VIEW nullable_window_mv AS
    SELECT a.id, a.v, b."p=key" AS pk,
           row_number() OVER (PARTITION BY b."p=key" ORDER BY a.id) AS rn
    FROM nullable_window_left a LEFT JOIN nullable_window_right b ON a.id=b.id;

statement ok
INSERT INTO nullable_window_left VALUES (3,30),(4,40);
UPDATE nullable_window_left SET v=111 WHERE id=1;
DELETE FROM nullable_window_left WHERE id=4;

statement ok
PRAGMA refresh('nullable_window_mv');

query I
SELECT count(*) FROM (
    (FROM nullable_window_mv EXCEPT ALL FROM nullable_window_expected)
    UNION ALL
    (FROM nullable_window_expected EXCEPT ALL FROM nullable_window_mv)
);
----
0

# A row admitted by a nested LIMIT can evict a row from another partition.
statement ok
CREATE TABLE window_limited_scores (id INT, "p=key" INT, score INT);
INSERT INTO window_limited_scores VALUES (1,1,100),(2,2,90),(3,3,80);
CREATE VIEW window_limited_expected AS
    SELECT id, "p=key" AS pk, score, row_number() OVER (PARTITION BY "p=key" ORDER BY id) AS rn
    FROM (SELECT * FROM window_limited_scores ORDER BY score DESC LIMIT 2) top_scores;
CREATE MATERIALIZED VIEW window_limited_mv AS
    SELECT id, "p=key" AS pk, score, row_number() OVER (PARTITION BY "p=key" ORDER BY id) AS rn
    FROM (SELECT * FROM window_limited_scores ORDER BY score DESC LIMIT 2) top_scores;

statement ok
INSERT INTO window_limited_scores VALUES (4,3,110),(5,4,1);
UPDATE window_limited_scores SET score=120 WHERE id=4;
DELETE FROM window_limited_scores WHERE id=5;

statement ok
PRAGMA refresh('window_limited_mv');

query I
SELECT count(*) FROM (
    (FROM window_limited_mv EXCEPT ALL FROM window_limited_expected)
    UNION ALL
    (FROM window_limited_expected EXCEPT ALL FROM window_limited_mv)
);
----
0

query I
SELECT count(*) > 0 FROM openivm_compiled_statements
WHERE operation = 'refresh' AND sql LIKE '%openivm_window_current%'
AND view_name = (SELECT view_name FROM openivm_views WHERE view_sql_name = 'window_limited_mv');
----
true

# A DISTINCT ON winner can move between window partitions.
statement ok
CREATE TABLE window_winner_scores (id INT, bucket INT, "p=key" INT, score INT);
INSERT INTO window_winner_scores VALUES (1,1,1,100),(2,2,2,90),(3,1,3,80);
CREATE VIEW window_winner_expected AS
    SELECT id, "p=key" AS pk, score, row_number() OVER (PARTITION BY "p=key" ORDER BY id) AS rn
    FROM (SELECT DISTINCT ON (bucket) * FROM window_winner_scores ORDER BY bucket, score DESC, id) winners;
CREATE MATERIALIZED VIEW window_winner_mv AS
    SELECT id, "p=key" AS pk, score, row_number() OVER (PARTITION BY "p=key" ORDER BY id) AS rn
    FROM (SELECT DISTINCT ON (bucket) * FROM window_winner_scores ORDER BY bucket, score DESC, id) winners;

statement ok
