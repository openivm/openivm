# ==========================================
# Test 11: RANGE frame with INTERVAL uses original SQL and partition refresh
# ==========================================

statement ok
CREATE TABLE w_history_range (h_w_id INT, h_date TIMESTAMP, h_amount INT);

statement ok
INSERT INTO w_history_range VALUES
    (1, '2026-01-01 00:00:00', 10),
    (1, '2026-01-10 00:00:00', 20),
    (1, '2026-02-20 00:00:00', 30),
    (2, '2026-01-05 00:00:00', 40);

statement ok
CREATE MATERIALIZED VIEW mv_window_range AS
    SELECT h_w_id, h_date, h_amount,
        COUNT(*) OVER (
            PARTITION BY h_w_id
            ORDER BY h_date
            RANGE BETWEEN INTERVAL '30 days' PRECEDING AND CURRENT ROW
        ) AS rolling_30d
    FROM w_history_range
    WHERE h_date IS NOT NULL;

query I
SELECT type FROM openivm_views WHERE view_name = '__openivm_mv_6d656d6f7279_6d61696e_6d765f77696e646f775f72616e6765_';
----
5

statement ok
INSERT INTO w_history_range VALUES (1, '2026-01-20 00:00:00', 50);

statement ok
PRAGMA refresh('mv_window_range');

query I
SELECT COUNT(*) FROM (
    SELECT h_w_id, h_date, h_amount,
        COUNT(*) OVER (
            PARTITION BY h_w_id
            ORDER BY h_date
            RANGE BETWEEN INTERVAL '30 days' PRECEDING AND CURRENT ROW
        )
    FROM w_history_range
    WHERE h_date IS NOT NULL
    EXCEPT ALL
    SELECT * FROM mv_window_range
);
----
0

query I
SELECT COUNT(*) FROM (
    SELECT * FROM mv_window_range
    EXCEPT ALL
    SELECT h_w_id, h_date, h_amount,
        COUNT(*) OVER (
            PARTITION BY h_w_id
            ORDER BY h_date
            RANGE BETWEEN INTERVAL '30 days' PRECEDING AND CURRENT ROW
        )
    FROM w_history_range
    WHERE h_date IS NOT NULL
);
----
0

# ==========================================
# Regression: downstream delta from window recompute
# ==========================================

statement ok
SET openivm_cascade_refresh='off';

statement ok
CREATE TABLE w_chain_src (d DATE, sym VARCHAR, lo INT, hi INT);

statement ok
INSERT INTO w_chain_src VALUES
    (DATE '2026-01-01', 'A', 10, 20),
    (DATE '2026-01-02', 'A', 8, 22);

statement ok
CREATE MATERIALIZED VIEW w_chain_l1 AS
SELECT d, sym, lo, hi FROM w_chain_src;

statement ok
CREATE MATERIALIZED VIEW w_chain_l2 AS
SELECT
    d,
    sym,
    lo,
    hi,
    MIN(lo) OVER (PARTITION BY sym ORDER BY d) AS running_lo,
    MAX(hi) OVER (PARTITION BY sym ORDER BY d) AS running_hi
FROM w_chain_l1;

statement ok
CREATE MATERIALIZED VIEW w_chain_l3 AS
SELECT d, sym, running_lo, running_hi FROM w_chain_l2;

statement ok
INSERT INTO w_chain_src VALUES (DATE '2026-01-03', 'A', 7, 25);

statement ok
PRAGMA refresh('w_chain_l1');

statement ok
PRAGMA refresh('w_chain_l2');

query I
SELECT count(*) FROM openivm_delta_openivm_visible___openivm_mv_6d656d6f7279_6d61696e_775f636861696e5f6c32_;
----
1

statement ok
PRAGMA refresh('w_chain_l3');

query I
SELECT count(*) FROM (
    SELECT * FROM w_chain_l3
    EXCEPT ALL
    SELECT d, sym, running_lo, running_hi FROM w_chain_l2
);
----
0

query I
SELECT count(*) FROM (
    SELECT d, sym, running_lo, running_hi FROM w_chain_l2
    EXCEPT ALL
    SELECT * FROM w_chain_l3
);
----
0

