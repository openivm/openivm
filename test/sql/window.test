# An upper window's key cannot limit changes to a source read by a lower window.
statement ok
CREATE VIEW window_before_join_late_source_expected AS
    SELECT t.aid,t.bid,t.ak AS k,t.lower_rn,
           row_number() OVER (PARTITION BY t.k ORDER BY t.aid,t.bid) AS upper_rn
    FROM (
        SELECT a.id AS aid,b.id AS bid,a.k AS ak,b.k AS k,
               row_number() OVER (PARTITION BY a.k ORDER BY a.id,b.id) AS lower_rn
        FROM window_before_join_a a CROSS JOIN window_before_join_b b
