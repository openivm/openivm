0

query I
SELECT count(*) FILTER (WHERE contains(sql, 'openivm_delta_composite_left_rows')
                          AND contains(sql, 'openivm_delta_composite_right_rows')
                          AND contains(sql, 'openivm_changed_partitions')) >= 2
       AND count(*) FILTER (WHERE contains(sql, 'openivm_window_current')) = 0
FROM openivm_compiled_statements
WHERE operation = 'refresh'
  AND view_name = (SELECT view_name FROM openivm_views WHERE view_sql_name = 'composite_join_mv');
----
true
