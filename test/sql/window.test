# ==========================================
# Test 7: Window over JOIN
# ==========================================

statement ok
CREATE TABLE w_orders (id INT, cust_id INT, amount INT);

statement ok
CREATE TABLE w_customers (id INT, name VARCHAR);

statement ok
INSERT INTO w_customers VALUES (1,'Alice'), (2,'Bob'), (3,'Carol');

statement ok
INSERT INTO w_orders VALUES (1,1,100), (2,1,200), (3,2,150), (4,2,50), (5,3,300);

statement ok
CREATE MATERIALIZED VIEW mv_wjoin AS
    SELECT o.id, c.name, o.amount,
        ROW_NUMBER() OVER (PARTITION BY c.name ORDER BY o.amount DESC) as rn
    FROM w_orders o JOIN w_customers c ON o.cust_id = c.id;

statement ok
INSERT INTO w_orders VALUES (6,1,500), (7,3,10);

statement ok
PRAGMA refresh('mv_wjoin');

query I
SELECT count(*) FROM (
    SELECT o.id, c.name, o.amount, ROW_NUMBER() OVER (PARTITION BY c.name ORDER BY o.amount DESC) FROM w_orders o JOIN w_customers c ON o.cust_id = c.id
    EXCEPT ALL SELECT * FROM mv_wjoin
);
----
0

query I
SELECT count(*) FROM (
    SELECT * FROM mv_wjoin
    EXCEPT ALL SELECT o.id, c.name, o.amount, ROW_NUMBER() OVER (PARTITION BY c.name ORDER BY o.amount DESC) FROM w_orders o JOIN w_customers c ON o.cust_id = c.id
);
----
0

