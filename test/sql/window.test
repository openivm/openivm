# An equality introduced after a window cannot scope that window's inputs.
statement ok
CREATE TABLE window_before_join_a (id INT, k INT, v INT);
CREATE TABLE window_before_join_b (id INT, k INT);
CREATE TABLE window_before_join_c (k INT);
INSERT INTO window_before_join_a VALUES (4,1,40),(5,2,50),(6,3,60);
INSERT INTO window_before_join_b VALUES (11,1),(12,2),(13,3);
INSERT INTO window_before_join_c VALUES (1),(2),(3);
CREATE VIEW window_before_join_expected AS
    SELECT t.aid,t.bid,t.k,t.lower_rn,
           row_number() OVER (PARTITION BY t.k ORDER BY t.aid,t.bid) AS upper_rn
    FROM (
        SELECT a.id AS aid,b.id AS bid,a.k AS k,b.k AS bk,
               row_number() OVER (PARTITION BY b.k ORDER BY a.id,b.id) AS lower_rn
        FROM window_before_join_a a CROSS JOIN window_before_join_b b
    ) t JOIN window_before_join_c c ON t.k=c.k AND t.bk=c.k;
CREATE MATERIALIZED VIEW window_before_join_mv AS
    SELECT t.aid,t.bid,t.k,t.lower_rn,
           row_number() OVER (PARTITION BY t.k ORDER BY t.aid,t.bid) AS upper_rn
    FROM (
        SELECT a.id AS aid,b.id AS bid,a.k AS k,b.k AS bk,
               row_number() OVER (PARTITION BY b.k ORDER BY a.id,b.id) AS lower_rn
        FROM window_before_join_a a CROSS JOIN window_before_join_b b
    ) t JOIN window_before_join_c c ON t.k=c.k AND t.bk=c.k;

