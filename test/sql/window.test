# A null-rejecting filter below the window makes the nullable-side key usable.
statement ok
INSERT INTO nullable_window_right VALUES (2,200);
CREATE VIEW filtered_window_expected AS
    SELECT a.id, a.v, b."p=key" AS pk,
           row_number() OVER (PARTITION BY b."p=key" ORDER BY a.id) AS rn
    FROM nullable_window_left a LEFT JOIN nullable_window_right b ON a.id=b.id
    WHERE b.id IS NOT NULL AND a.v > 0;
CREATE MATERIALIZED VIEW filtered_window_mv AS
    SELECT a.id, a.v, b."p=key" AS pk,
           row_number() OVER (PARTITION BY b."p=key" ORDER BY a.id) AS rn
    FROM nullable_window_left a LEFT JOIN nullable_window_right b ON a.id=b.id
    WHERE b.id IS NOT NULL AND a.v > 0;
CREATE VIEW comparison_window_expected AS
    SELECT a.id, a.v, b."p=key" AS pk,
           row_number() OVER (PARTITION BY b."p=key" ORDER BY a.id) AS rn
    FROM nullable_window_left a LEFT JOIN nullable_window_right b ON a.id=b.id
    WHERE b.id > 0 AND a.v > 0;
CREATE MATERIALIZED VIEW comparison_window_mv AS
    SELECT a.id, a.v, b."p=key" AS pk,
           row_number() OVER (PARTITION BY b."p=key" ORDER BY a.id) AS rn
    FROM nullable_window_left a LEFT JOIN nullable_window_right b ON a.id=b.id
    WHERE b.id > 0 AND a.v > 0;
CREATE VIEW disjunction_window_expected AS
    SELECT a.id, a.v, b."p=key" AS pk,
           row_number() OVER (PARTITION BY b."p=key" ORDER BY a.id) AS rn
    FROM nullable_window_left a LEFT JOIN nullable_window_right b ON a.id=b.id
    WHERE b.id > 0 OR b."p=key" > 0;
CREATE MATERIALIZED VIEW disjunction_window_mv AS
    SELECT a.id, a.v, b."p=key" AS pk,
           row_number() OVER (PARTITION BY b."p=key" ORDER BY a.id) AS rn
    FROM nullable_window_left a LEFT JOIN nullable_window_right b ON a.id=b.id
    WHERE b.id > 0 OR b."p=key" > 0;
