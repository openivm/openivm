0

query I
SELECT count(*) > 0 FROM openivm_compiled_statements
WHERE operation = 'refresh' AND sql LIKE '%openivm_changed_rows%'
AND view_name = (SELECT view_name FROM openivm_views WHERE view_sql_name = 'quoted_window_cross_mv');
