    SELECT id, grp, val, ROW_NUMBER() OVER (PARTITION BY grp ORDER BY val, id) AS rn
    FROM w_null_part
    EXCEPT ALL
    SELECT * FROM mv_null_part
);
----
0

query I
SELECT count(*) FROM (
    SELECT * FROM mv_null_part
    EXCEPT ALL
    SELECT id, grp, val, ROW_NUMBER() OVER (PARTITION BY grp ORDER BY val, id) AS rn
    FROM w_null_part
);
