# DML CTEs snapshot affected partitions before replacing rows and publishing deltas.
statement ok
SET openivm_cascade_refresh='downstream';
SET openivm_disable_daemon=true;
SET openivm_archive_compiled_sql=true;
CREATE TABLE cte_window_source(id INTEGER,k INTEGER,v INTEGER);
INSERT INTO cte_window_source VALUES (1,1,10),(2,1,20),(3,NULL,30),(4,2,NULL);
CREATE VIEW cte_window_expected AS
SELECT *,row_number() OVER(PARTITION BY k ORDER BY v NULLS LAST,id) rn FROM cte_window_source;
CREATE MATERIALIZED VIEW cte_window_mv AS
SELECT *,row_number() OVER(PARTITION BY k ORDER BY v NULLS LAST,id) rn FROM cte_window_source;
CREATE MATERIALIZED VIEW cte_window_child AS SELECT k,count(*) c FROM cte_window_mv GROUP BY k;

statement ok
INSERT INTO cte_window_source VALUES (5,1,15),(5,1,15),(6,NULL,40);
UPDATE cte_window_source SET v=v+1 WHERE id=1;
DELETE FROM cte_window_source WHERE id IN (2,6);
UPDATE cte_window_source SET v=NULL WHERE id=5;

statement ok
PRAGMA refresh_pipeline('cte_window_mv');

query I
SELECT count(*) FROM (
 (SELECT * FROM cte_window_mv EXCEPT ALL SELECT * FROM cte_window_expected) UNION ALL
 (SELECT * FROM cte_window_expected EXCEPT ALL SELECT * FROM cte_window_mv) UNION ALL
 (SELECT NULL,k,c,NULL FROM cte_window_child EXCEPT ALL
  SELECT NULL,k,count(*),NULL FROM cte_window_expected GROUP BY k) UNION ALL
 (SELECT NULL,k,count(*),NULL FROM cte_window_expected GROUP BY k EXCEPT ALL
  SELECT NULL,k,c,NULL FROM cte_window_child)
);
----
0

query I
SELECT count(*)>0 FROM openivm_compiled_statements
WHERE operation='refresh' AND sql LIKE '%AS MATERIALIZED (DELETE FROM%';
----
true

statement ok
BEGIN;
DELETE FROM cte_window_source WHERE k=1;
UPDATE cte_window_source SET k=2 WHERE k IS NULL;

statement ok
PRAGMA refresh_pipeline('cte_window_mv');

query I
SELECT count(*) FROM (
 (SELECT * FROM cte_window_mv EXCEPT ALL SELECT * FROM cte_window_expected) UNION ALL
 (SELECT * FROM cte_window_expected EXCEPT ALL SELECT * FROM cte_window_mv) UNION ALL
 (SELECT NULL,k,c,NULL FROM cte_window_child EXCEPT ALL
  SELECT NULL,k,count(*),NULL FROM cte_window_expected GROUP BY k) UNION ALL
 (SELECT NULL,k,count(*),NULL FROM cte_window_expected GROUP BY k EXCEPT ALL
  SELECT NULL,k,c,NULL FROM cte_window_child)
);
----
0

statement ok
ROLLBACK;

query I
SELECT count(*) FROM (
 (SELECT * FROM cte_window_mv EXCEPT ALL SELECT * FROM cte_window_expected) UNION ALL
 (SELECT * FROM cte_window_expected EXCEPT ALL SELECT * FROM cte_window_mv) UNION ALL
 (SELECT NULL,k,c,NULL FROM cte_window_child EXCEPT ALL
  SELECT NULL,k,count(*),NULL FROM cte_window_expected GROUP BY k) UNION ALL
 (SELECT NULL,k,count(*),NULL FROM cte_window_expected GROUP BY k EXCEPT ALL
  SELECT NULL,k,c,NULL FROM cte_window_child)
);
----
0

# An equals sign can occur in either side of a window column mapping.
statement ok
CREATE TABLE quoted_window_source (id INT, "k=1" INT, "sort=order" INT);
INSERT INTO quoted_window_source VALUES (1,1,10),(2,1,20),(3,2,30),(4,NULL,40);
CREATE VIEW quoted_window_expected AS
    SELECT id, "k=1" AS "=", "sort=order" AS ord,
           row_number() OVER (PARTITION BY "k=1" ORDER BY "sort=order", id) AS rn
    FROM quoted_window_source;
CREATE MATERIALIZED VIEW quoted_window_mv AS
    SELECT id, "k=1" AS "=", "sort=order" AS ord,
           row_number() OVER (PARTITION BY "k=1" ORDER BY "sort=order", id) AS rn
    FROM quoted_window_source;

query I
SELECT group_columns IS NOT NULL AND lineage_json LIKE '%"source_col":"k=1"%'
FROM openivm_views WHERE view_sql_name = 'quoted_window_mv';
----
true

statement ok
INSERT INTO quoted_window_source VALUES (5,1,15),(6,NULL,5);
UPDATE quoted_window_source SET "k=1" = NULL, "sort=order" = 1 WHERE id = 5;
DELETE FROM quoted_window_source WHERE id IN (2, 6);

statement ok
PRAGMA refresh('quoted_window_mv');

query I
SELECT count(*) FROM (
    (SELECT * FROM quoted_window_mv EXCEPT ALL SELECT * FROM quoted_window_expected)
    UNION ALL
    (SELECT * FROM quoted_window_expected EXCEPT ALL SELECT * FROM quoted_window_mv)
);
----
0

# A cast-only projection cannot identify the raw decimal partition.
statement ok
CREATE TABLE quoted_window_decimal ("p=key" DECIMAL(4,1), v INT);
INSERT INTO quoted_window_decimal VALUES (1.1,10),(1.1,20),(1.2,17),(2,30);
CREATE VIEW quoted_window_cast_expected AS
    SELECT "p=key"::INT AS projected, v, row_number() OVER (PARTITION BY "p=key" ORDER BY v) AS rn
    FROM quoted_window_decimal;
CREATE MATERIALIZED VIEW quoted_window_cast_mv AS
    SELECT "p=key"::INT AS projected, v, row_number() OVER (PARTITION BY "p=key" ORDER BY v) AS rn
    FROM quoted_window_decimal;

statement ok
INSERT INTO quoted_window_decimal VALUES (1.1,5),(1.1,15);
UPDATE quoted_window_decimal SET v=23 WHERE v=20;
DELETE FROM quoted_window_decimal WHERE v=15;

statement ok
PRAGMA refresh('quoted_window_cast_mv');

query I
SELECT count(*) FROM (
    (FROM quoted_window_cast_mv EXCEPT ALL FROM quoted_window_cast_expected)
    UNION ALL
    (FROM quoted_window_cast_expected EXCEPT ALL FROM quoted_window_cast_mv)
);
----
0

# The stored partition key must follow the bound left column even when a
# different column with the same name is projected first.
statement ok
CREATE TABLE quoted_window_left (id INT, "p=key" INT);
CREATE TABLE quoted_window_right (id INT, "p=key" INT, v INT);
INSERT INTO quoted_window_left VALUES (1,1),(2,1),(3,2);
INSERT INTO quoted_window_right VALUES (1,10,10),(2,20,20),(3,30,30);
CREATE VIEW quoted_window_join_expected AS
    SELECT b."p=key" AS unrelated, a."p=key" AS pk, b.v,
           row_number() OVER (PARTITION BY a."p=key" ORDER BY b.v) AS rn
    FROM quoted_window_left a JOIN quoted_window_right b USING (id);
CREATE MATERIALIZED VIEW quoted_window_join_mv AS
    SELECT b."p=key" AS unrelated, a."p=key" AS pk, b.v,
           row_number() OVER (PARTITION BY a."p=key" ORDER BY b.v) AS rn
    FROM quoted_window_left a JOIN quoted_window_right b USING (id);

query T
SELECT group_columns FROM openivm_views WHERE view_sql_name = 'quoted_window_join_mv';
----
pk=p=key

statement ok
INSERT INTO quoted_window_left VALUES (4,1),(5,2);
INSERT INTO quoted_window_right VALUES (4,40,5),(5,50,50);
UPDATE quoted_window_right SET v=23 WHERE id=2;
DELETE FROM quoted_window_right WHERE id=5;

statement ok
PRAGMA refresh('quoted_window_join_mv');

query I
SELECT count(*) FROM (
    (FROM quoted_window_join_mv EXCEPT ALL FROM quoted_window_join_expected)
    UNION ALL
    (FROM quoted_window_join_expected EXCEPT ALL FROM quoted_window_join_mv)
);
----
0

# A namesake column on the right of a cross join does not bound which left
# partitions can change. Use the changed result partitions instead.
statement ok
CREATE TABLE quoted_window_cross_left (id INT, "p=key" INT);
CREATE TABLE quoted_window_cross_right (id INT, "p=key" INT, v INT);
INSERT INTO quoted_window_cross_left VALUES (1,1),(2,1),(3,2);
INSERT INTO quoted_window_cross_right VALUES (10,100,10),(11,200,20);
CREATE VIEW quoted_window_cross_expected AS
    SELECT a."p=key" AS pk, a.id AS aid, b.id AS bid, b.v,
           row_number() OVER (PARTITION BY a."p=key" ORDER BY a.id,b.id) AS rn
    FROM quoted_window_cross_left a CROSS JOIN quoted_window_cross_right b;
CREATE MATERIALIZED VIEW quoted_window_cross_mv AS
    SELECT a."p=key" AS pk, a.id AS aid, b.id AS bid, b.v,
           row_number() OVER (PARTITION BY a."p=key" ORDER BY a.id,b.id) AS rn
    FROM quoted_window_cross_left a CROSS JOIN quoted_window_cross_right b;

statement ok
