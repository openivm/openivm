CREATE VIEW window_nullsafe_expected AS
    SELECT a.id AS aid,b.id AS bid,a.k,a.q,a.v+b.v AS v,
           row_number() OVER (PARTITION BY a.k,a.q ORDER BY a.id,b.id) AS rn
    FROM window_nullsafe_a a JOIN window_nullsafe_b b
    ON a.k IS NOT DISTINCT FROM b.k AND a.q IS NOT DISTINCT FROM b.q;
CREATE MATERIALIZED VIEW window_nullsafe_mv AS
    SELECT a.id AS aid,b.id AS bid,a.k,a.q,a.v+b.v AS v,
           row_number() OVER (PARTITION BY a.k,a.q ORDER BY a.id,b.id) AS rn
    FROM window_nullsafe_a a JOIN window_nullsafe_b b
    ON a.k IS NOT DISTINCT FROM b.k AND a.q IS NOT DISTINCT FROM b.q;

