UPDATE quoted_window_cross_right SET v=100 WHERE id=10;
DELETE FROM quoted_window_cross_right WHERE id IN (11,13);

statement ok
PRAGMA refresh('quoted_window_cross_mv');

query I
SELECT count(*) FROM (
    (FROM quoted_window_cross_mv EXCEPT ALL FROM quoted_window_cross_expected)
    UNION ALL
    (FROM quoted_window_cross_expected EXCEPT ALL FROM quoted_window_cross_mv)
);
