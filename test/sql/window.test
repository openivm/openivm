# name: test/sql/window.test
# description: Test IVM for window functions via partition-level recompute
# group: [sql]

require openivm

statement ok
SET openivm_files_path='__TEST_DIR__';

# ==========================================
# Test 1: ROW_NUMBER with PARTITION BY
# ==========================================

statement ok
CREATE TABLE wt (id INT, grp VARCHAR, val INT);

statement ok
INSERT INTO wt VALUES (1,'a',10), (2,'a',30), (3,'a',20), (4,'b',5), (5,'b',15), (6,'b',25);

statement ok
CREATE MATERIALIZED VIEW mv_rn AS
    SELECT id, grp, val, ROW_NUMBER() OVER (PARTITION BY grp ORDER BY val) as rn FROM wt;

# Spark compilation uses the ordered scratch-table program even when the
# compiler's temporary catalog is native DuckDB and supports DML CTEs.
query I
SELECT COUNT(*) FROM openivm_compile_with_facts(
    'mv_rn', '{"target_dialect":"spark","compile_only":true,"force_view_delta_cascade":true}'
) WHERE sql ILIKE '%AS MATERIALIZED (%';
----
0

query I
SELECT COUNT(*) FROM openivm_compile_with_facts(
    'mv_rn', '{"target_dialect":"duckdb","compile_only":true,"force_view_delta_cascade":true}'
) WHERE sql ILIKE '%AS MATERIALIZED (%';
----
1

query I
SELECT count(*) FROM mv_rn;
----
6

# Insert into group 'a' only — group 'b' should be unaffected
statement ok
INSERT INTO wt VALUES (7,'a',25);

statement ok
PRAGMA refresh('mv_rn');

query I
SELECT count(*) FROM mv_rn;
----
7

# Cross-check both directions
query I
SELECT count(*) FROM (
    SELECT id, grp, val, ROW_NUMBER() OVER (PARTITION BY grp ORDER BY val) as rn FROM wt
    EXCEPT ALL SELECT * FROM mv_rn
);
----
0

query I
SELECT count(*) FROM (
    SELECT * FROM mv_rn
    EXCEPT ALL SELECT id, grp, val, ROW_NUMBER() OVER (PARTITION BY grp ORDER BY val) as rn FROM wt
);
----
0

