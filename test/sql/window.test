# Different expressions named k can share one real partition key, q.
statement ok
CREATE TABLE window_namesake_left (id INT, k INT, q INT, v INT);
CREATE TABLE window_namesake_right (id INT, k INT, q INT, v INT);
INSERT INTO window_namesake_left VALUES (4,1,10,40),(5,2,10,50),(6,3,20,60);
INSERT INTO window_namesake_right VALUES (11,1,10,90),(12,2,10,92),(13,3,20,94);
CREATE VIEW window_namesake_expected AS
    SELECT l.id AS lid,r.id AS rid,l.k,l.q,l.v+r.v AS v,
           row_number() OVER (PARTITION BY l.k,l.q ORDER BY l.id,r.id) AS lrn,
           row_number() OVER (PARTITION BY r.k,l.q ORDER BY l.id,r.id) AS rrn
    FROM window_namesake_left AS l
    JOIN (SELECT id,k AS join_k,q,v,v%2 AS k FROM window_namesake_right) r ON l.k=r.join_k AND l.q=r.q;
CREATE MATERIALIZED VIEW window_namesake_mv AS
    SELECT l.id AS lid,r.id AS rid,l.k,l.q,l.v+r.v AS v,
           row_number() OVER (PARTITION BY l.k,l.q ORDER BY l.id,r.id) AS lrn,
           row_number() OVER (PARTITION BY r.k,l.q ORDER BY l.id,r.id) AS rrn
    FROM window_namesake_left AS l
    JOIN (SELECT id,k AS join_k,q,v,v%2 AS k FROM window_namesake_right) r ON l.k=r.join_k AND l.q=r.q;

