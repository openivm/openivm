# DuckLake stores the original spelling of a partition key that metadata records in its
# prepared form. The change feed still scopes refresh by that key.
statement ok
SET openivm_archive_compiled_sql = true;
CREATE TABLE dl.quoted_scope_src (id INT, "g,1" VARCHAR, val INT);
INSERT INTO dl.quoted_scope_src SELECT i, chr((97 + i % 4)::INT), (i * 7) % 13 FROM range(30) t(i);
CREATE VIEW quoted_scope_expected AS
    SELECT id, "g,1", val, row_number() OVER (PARTITION BY "g,1" ORDER BY val, id) AS rn FROM dl.quoted_scope_src;
CREATE MATERIALIZED VIEW dl.quoted_scope_mv AS
    SELECT id, "g,1", val, row_number() OVER (PARTITION BY "g,1" ORDER BY val, id) AS rn FROM dl.quoted_scope_src;

