# Session collation applies on the helper connections as well as the caller.
statement ok
SET SESSION default_collation = 'nocase';
SET openivm_snapshot_publication = true;
CREATE TABLE dl.window_collated_source (id INT, "p=key" INT, label VARCHAR);
INSERT INTO dl.window_collated_source VALUES (1,1,'A'),(2,2,'B'),(3,3,'C');
CREATE VIEW window_collated_expected AS
    SELECT id,"p=key" AS pk,label,row_number() OVER (PARTITION BY "p=key" ORDER BY id) AS rn
    FROM dl.window_collated_source;
CREATE MATERIALIZED VIEW dl.window_collated_compact AS
    SELECT id,"p=key" AS pk,label,row_number() OVER (PARTITION BY "p=key" ORDER BY id) AS rn
    FROM dl.window_collated_source;
CREATE MATERIALIZED VIEW dl.window_collated_result AS
    SELECT id,"p=key" AS pk,label,row_number() OVER (PARTITION BY "p=key" ORDER BY id) AS rn
    FROM (SELECT * FROM dl.window_collated_source ORDER BY id LIMIT 10) input;
CREATE MATERIALIZED VIEW dl.window_collated_compact_child AS
    SELECT * FROM dl.window_collated_compact WHERE id > 0;
CREATE MATERIALIZED VIEW dl.window_collated_result_child AS
    SELECT * FROM dl.window_collated_result WHERE id > 0;

