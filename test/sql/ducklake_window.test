CREATE VIEW same_key_window_expected AS
    SELECT a.k, a.id AS aid, b.id AS bid, b.v,
           row_number() OVER (PARTITION BY a.k ORDER BY a.id,b.id) AS rn
    FROM dl.same_key_window_source a JOIN dl.same_key_window_source b ON a.k=b.k;
CREATE MATERIALIZED VIEW dl.same_key_window_mv AS
    SELECT a.k, a.id AS aid, b.id AS bid, b.v,
           row_number() OVER (PARTITION BY a.k ORDER BY a.id,b.id) AS rn
    FROM dl.same_key_window_source a JOIN dl.same_key_window_source b ON a.k=b.k;

