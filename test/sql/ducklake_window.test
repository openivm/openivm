    (SELECT *,date_part('month',duration),signbit(readings[1]) FROM dl.window_identity_{path}_child_{snapshot}
     EXCEPT ALL
     SELECT *,date_part('month',duration),signbit(readings[1]) FROM window_identity_expected_{snapshot})
    UNION ALL
    (SELECT *,date_part('month',duration),signbit(readings[1]) FROM window_identity_expected_{snapshot}
     EXCEPT ALL
     SELECT *,date_part('month',duration),signbit(readings[1]) FROM dl.window_identity_{path}_child_{snapshot})
);
