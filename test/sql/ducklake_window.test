CREATE TABLE dl.window_composite_src (
    w_id INT,
    d_id INT,
    event_ts INT,
    amount INT
);

statement ok
CREATE MATERIALIZED VIEW dl.mv_composite_window AS
SELECT
    w_id,
    d_id,
    event_ts,
    amount,
    SUM(amount) OVER (
        PARTITION BY w_id, d_id
        ORDER BY event_ts
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS running_amount
FROM dl.window_composite_src;

