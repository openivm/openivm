    SELECT id,k,"q=key" AS q2,score,row_number() OVER (PARTITION BY k,"q=key" ORDER BY id) AS rn
    FROM (SELECT DISTINCT ON (k) * FROM dl.partition_winner_scores ORDER BY k,score DESC,id) winners;

